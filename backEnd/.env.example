# Server Port
PORT=5002

# MongoDB Atlas Connection URI (Rotate password before production deployment)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/stock_ml?retryWrites=true&w=majority

# Python ML Microservice URL (Local: http://localhost:5001, Render: internal or public URL)
ML_SERVICE_URL=http://localhost:5001

# Allowed Frontend URL for CORS (e.g. https://stockwise-frontend.onrender.com or http://localhost:8080)
FRONTEND_URL=http://localhost:8080
